  journal = {Revista de Economia},
  volume = {34},
  number = {4},
  url = {http://revistas.ufpr.br/economia/article/view/17173},
  urldate = {2026-03-07},
  abstract = {A melhor forma de celebrar os 140 anos da publica\c c\~ao da obraprimade Marx, O Capital, \'e indubitavelmente recuperar o seu sentido originalde cr\'itica cient\'ifica das condi\c c\~oes sociais que, de um lado, criam as condi\c c\~oesmateriais para e, de outro, impedem a realiza\c c\~ao da emancipa\c c\~ao humana:a sociedade regida pelo capital. E isso porque o nexo entre cr\'itica cient\'ificae emancipa\c c\~ao humana perdeu-se, no s\'eculo XX, em meio a uma atmosferaque combinou um crescente recrudescimento do pensamento conservadorcom o descr\'edito das vers\~oes vulgarizadas do pensamento de Marx que amparavamas experi\^encias do socialismo real no plano subjetivo. Para superar apesada heran\c ca deste per\'iodo e restaurar aquele sentido fundamental de OCapital, \'e imprescind\'ivel recuperar seu argumento desde o ponto de partidaassumido pelo pr\'oprio autor: a an\'alise da circula\c c\~ao de mercadorias e dasformas de consci\^encia, inclusive cient\'ificas, a ela associadas.},
  langid = {portuguese},
  keywords = {marxism}
}

