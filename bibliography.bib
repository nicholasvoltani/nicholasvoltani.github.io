@article{Pimentel2017,
  title = {{Uma perspectiva realista cr\'itica sobre a\c c\~ao coletiva em economia}},
  author = {Pimentel, Thiago Duarte and Rodriguez, Rodrigo Siqueira},
  year = {2017-Jan-Mar},
  journal = {Brazilian Journal of Political Economy},
  volume = {37},
  pages = {208--225},
  url = {https://www.scielo.br/j/rep/a/gZjKGMMNMp6bwSBX4YP3t4g/?lang=pt},
  urldate = {2025-06-05},
  abstract = {RESUMO A vis\~ao predominante na economia tradicional assume que o objeto de an\'alise das rela\c c\~oes econ\^omicas \'e o indiv\'iduo, seja pela intera\c c\~ao econ\^omica entre eles (troca) seja pela intera\c c\~ao econ\^omica entre indiv\'iduos e coisas (produ\c c\~ao). Dificilmente a ci\^encia econ\^omica assume suposi\c c\~oes a respeito de indiv\'iduos organizados coletivamente. Em geral, quando o faz, assume que estas formas sejam um efeito agregado das a\c c\~oes individuais isoladas, ensejando assim uma posi\c c\~ao baseada no individualismo metodol\'ogico. Em microeconomia, por exemplo, uma afirma\c c\~ao sobre um grupo de indiv\'iduos, uma firma ou mesmo a sociedade, assume necessariamente que suas a\c c\~oes sejam abordadas a partir dos efeitos de maximiza\c c\~oes individuais, ainda que isso exija a generaliza\c c\~ao de condi\c c\~oes r\'igidas sobre o comportamento humano, improv\'aveis para sustentar as cren\c cas e os desejos individuais. Esse trabalho tem como objetivo apresentar um modelo de an\'alise alternativo \`aquele paradigma, que simultaneamente esteja comprometido com uma an\'alise realista e incorpore elementos contextuais e emp\'iricos alusivos \`a conduta humana. Situando nosso foco no n\'ivel mesossociol\'ogico de an\'alise, argumentamos que a an\'alise da a\c c\~ao coletiva, fundamentada no realismo cr\'itico, constitui-se numa alternativa para direcionar os estudos em economia.},
  langid = {portuguese},
  keywords = {economics,philosophy/critical_realism}
}

