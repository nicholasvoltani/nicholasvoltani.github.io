@article{Correa2025,
  title = {As Categorias Em {{Hegel}}: L\'ogica, Metaf\'isica e M\'etodo},
  shorttitle = {As Categorias Em {{Hegel}}},
  author = {Corr{\^e}a, R{\^o}mulo Ferreira},
  year = 2025,
  month = sep,
  journal = {Revista Eletr\^onica Estudos Hegelianos},
  volume = {22},
  number = {40},
  pages = {158--186},
  url = {https://ojs.hegelbrasil.org/index.php/reh/article/view/569},
  urldate = {2025-10-24},
  abstract = {The article investigates the problem of categories within the philosophical tradition, with Hegel's Science of Logic as its point of arrival. To situate its specificity, we analyze the treatment of categories in Aristotle and Kant, considering in each author the definition of the concept of category, the method employed in its deduction, and the relation established between logic and metaphysics. We show how, in Hegel, the issue undergoes a decisive reformulation: the ordering of categories is not conceived as an arbitrary list nor as a mere condition of possibility of experience, but as the immanent development of thought, in which logic and metaphysics coincide. The study thus seeks to highlight how the Hegelian dialectical method responds to the problem of the scientific character of philosophy, articulating the categorial deduction with the identity of being and thought.           ,              O artigo pretende abordar o tema das categorias sob a perspectiva da filosofia de Hegel. Para a abordagem dessa tem\'atica procedemos ao resgate do debate filos\'ofico acerca das categorias em Arist\'oteles e Kant, e ao cotejo destes com o tratamento dado por Hegel. Como metodologia de an\'alise consideramos como indicadores principais, em cada autor, a defini\c c\~ao da categoria de categoria, o m\'etodo utilizado para conceb\^e-las, e a rela\c c\~ao entre L\'ogica e Metaf\'isica. O estudo procura real\c car a relev\^ancia atual do tema e demonstrar como o tratamento dado por Hegel soluciona os problemas colocados por Kant, ao utilizar a dial\'etica como m\'etodo anal\'itico-sint\'etico a priori, sem para isso ter que despojar o estudo do ser (a Metaf\'isica) da sua inten\c c\~ao original: o conhecimento da coisa-em-si. Palavras-chave: Categorias, L\'ogica, Metaf\'isica, M\'etodo, Hegel.},
  keywords = {philosophy,philosophy/dialectics}
}

